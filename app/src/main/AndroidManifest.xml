<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChamCay">

        <!-- Màn hình khởi động -->
        <activity android:name=".SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Xác thực tài khoản -->
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".AccountActivity" android:exported="false" />

        <!-- Chức năng chính -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".NotificationsActivity" android:exported="false" />
        <activity android:name=".MyPlantsActivity" android:exported="false" />
        <activity android:name=".PlantDetailActivity" android:exported="false" />
        <activity android:name=".ChangeInformationPlantActivity" android:exported="false" />

        <!-- Nhật ký & Thống kê -->
        <activity android:name=".CareLogActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".GrowthJourneyActivity" android:exported="false" />
        <activity android:name=".AddGrowthImageActivity" android:exported="false" />
        <activity android:name=".StatisticsMainActivity" android:exported="false" />
        <activity android:name=".StatisticsChartsActivity" android:exported="false" />

        <!-- Trợ lý AI -->
        <activity android:name=".AiCareInputActivity" android:exported="false" />
        <activity android:name=".AiHistoryActivity" android:exported="false" />
        <activity android:name=".AiResultActivity" android:exported="false" />
        <activity android:name=".AiScheduleProposalActivity" android:exported="false" />

        <!-- Giám sát IoT -->
        <activity android:name=".IotMonitoringActivity" android:exported="false" />
        <activity android:name=".IotSensorDetailsActivity" android:exported="false" />

        <!-- Quản trị viên -->
        <activity android:name=".AdminDashboardActivity" android:exported="false" />
        <activity android:name=".AdminUsersActivity" android:exported="false" />

    </application>
</manifest>