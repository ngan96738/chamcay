<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:paddingTop="48dp" > <!-- Đẩy nội dung xuống 48dp để tránh camera -->

        <LinearLayout
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView android:text="Xin chào, Nguyên 👋" android:textSize="22sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Thứ Năm, 08/10/2026" android:textSize="12sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>

            <!-- Card Tổng quan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#E8F5E9"
                app:cardElevation="0dp">
                <LinearLayout android:padding="16dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="Khu vườn của bạn" android:textSize="12sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="5 cây · 4 cây khỏe" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                    <TextView android:text="1 cây cần theo dõi · Sen đá" android:textSize="12sp" android:textColor="#388E3C" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Công việc hôm nay -->
            <TextView android:text="Hôm nay cần chăm sóc" android:textSize="16sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="💧" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp"/>
                    <TextView android:text="Tưới cây Monstera\n17:30 · Kiểm tra đất" android:textColor="#1E392A" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <TextView android:text="Sắp đến" android:textColor="#F57F17" android:background="#FFF9C4" android:padding="8dp" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NHỮNG NGƯỜI BẠN XANH -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <TextView android:text="Những người bạn xanh" android:textSize="16sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Xem tất cả" android:textSize="12sp" android:textColor="#2E7D32" android:layout_alignParentEnd="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </RelativeLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="20dp">
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="vertical" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp">
                        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="100dp" app:cardCornerRadius="12dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/img_monstera"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:text="Monstera" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Đang phát triển tốt" android:textSize="10sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:layout_width="140dp" android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="100dp" app:cardCornerRadius="12dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/img_senda"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:text="Sen đá" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Cần theo dõi" android:textSize="10sp" android:textColor="#F57F17" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Lưới Môi trường -->
            <TextView android:text="Môi trường · Monstera" android:textSize="16sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="16dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp" android:layout_marginEnd="6dp">
                    <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="💧" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="52%" android:textSize="18sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                        <TextView android:text="Độ ẩm đất" android:textSize="10sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp" android:layout_marginEnd="6dp" android:layout_marginStart="6dp">
                    <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="🌡️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="29°C" android:textSize="18sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                        <TextView android:text="Nhiệt độ" android:textSize="10sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp" android:layout_marginStart="6dp">
                    <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="💨" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="68%" android:textSize="18sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                        <TextView android:text="Độ ẩm k.khí" android:textSize="10sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 3 Nút Thao tác nhanh (Bổ sung mới) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="24dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardBackgroundColor="#E8F5E9" app:cardElevation="0dp" android:layout_marginEnd="6dp">
                    <TextView android:text="➕\nThêm cây" android:gravity="center" android:padding="12dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardBackgroundColor="#E8F5E9" app:cardElevation="0dp" android:layout_marginEnd="6dp" android:layout_marginStart="6dp">
                    <TextView android:text="📅\nXem lịch" android:gravity="center" android:padding="12dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardBackgroundColor="#E8F5E9" app:cardElevation="0dp" android:layout_marginStart="6dp">
                    <TextView android:text="✨\nAI tư vấn" android:gravity="center" android:padding="12dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Thanh điều hướng Bottom Nav 5 mục -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:gravity="center_vertical">

        <TextView android:text="🏠\nTrang chủ" android:gravity="center" android:textColor="#2E7D32" android:textSize="11sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:text="🌱\nCây của tôi" android:gravity="center" android:textColor="#757575" android:textSize="11sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:text="📅\nLịch" android:gravity="center" android:textColor="#757575" android:textSize="11sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:text="📈\nThống kê" android:gravity="center" android:textColor="#757575" android:textSize="11sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:text="👤\nTài khoản" android:gravity="center" android:textColor="#757575" android:textSize="11sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>

    </LinearLayout>
</RelativeLayout>