<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView android:text="←" android:textSize="24sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:text="25 · IoT" android:textSize="12sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Điều khiển tưới" android:textSize="24sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tag Tính năng mở rộng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tính năng mở rộng"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#BF360C"
            android:background="#FFF9C4"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- Card Chọn cây -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardStrokeWidth="1dp"
            app:cardStrokeColor="#E0E0E0">
            <LinearLayout android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/img_monstera"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
                    <TextView android:text="Monstera" android:textStyle="bold" android:textSize="14sp" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Trồng ngày 01/09/2026" android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:text="▾" android:textSize="16sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tabs Chế độ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#EFEBE9"
            android:padding="3dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="10dp"
            android:weightSum="2">

            <TextView android:text="Thủ công" android:background="@android:color/white" android:textStyle="bold" android:textColor="#1E392A" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            <TextView android:text="Tự động" android:textColor="#424242" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>        </LinearLayout>

        <!-- Thẻ trạng thái Bơm (Thủ công) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F5E9">

            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="⏻" android:textSize="28sp" android:textColor="#2E7D32" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="Bơm đang tắt" android:textStyle="bold" android:textSize="18sp" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="ESP32 trực tuyến · Chế độ thủ công" android:textSize="11sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:text="Độ ẩm đất hiện tại: 52%. Chưa cần tưới ngay." android:textSize="12sp" android:textColor="#1E392A" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#2E7D32"
                    android:text="⏻ Bật bơm"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Thẻ Cấu hình chế độ tự động -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardStrokeWidth="1dp"
            app:cardStrokeColor="#E0E0E0">

            <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Cấu hình chế độ tự động" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_marginBottom="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <TextView android:text="Ngưỡng độ ẩm đất" android:textStyle="bold" android:textColor="#1E392A" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white" app:cardStrokeWidth="1dp" app:cardStrokeColor="#E0E0E0">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@null" android:hint="Dưới 35%" android:textColorHint="#757575" android:padding="12dp" android:textSize="14sp" android:inputType="text"/>
                        <TextView android:text="💧" android:textSize="16sp" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView android:text="Đã lưu · Chỉ áp dụng khi chọn Tự động. Bơm dừng ở 55% hoặc sau 20 giây." android:textSize="11sp" android:textColor="#757575" android:lineSpacingExtra="2dp" android:layout_marginBottom="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <TextView android:text="Tự động chưa bật" android:textSize="11sp" android:textStyle="bold" android:textColor="#424242" android:background="#EFEBE9" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Thẻ Cảnh báo an toàn -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFF9C4">
            <TextView android:text="Kiểm tra bình nước và ống dẫn trước khi bật. Dừng bơm ngay nếu có rò rỉ." android:textColor="#BF360C" android:textSize="12sp" android:padding="12dp" android:lineSpacingExtra="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>

        <!-- Footer -->
        <TextView android:text="Khi bơm hoạt động, nút đổi thành &quot;Tắt bơm&quot;." android:textSize="11sp" android:textColor="#757575" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>