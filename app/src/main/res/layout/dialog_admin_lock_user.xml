<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Tiêu đề & Nút Đóng (X) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Khóa tài khoản?"
                android:textColor="#212529"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:text="✕"
                android:textColor="#70757A"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Mô tả đối tượng bị khóa -->
        <TextView
            android:id="@+id/tvLockAccountInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="3dp"
            android:text="Khóa tài khoản Minh Anh\n(minhanh@gmail.com)?"
            android:textColor="#212529"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Ghi chú giải thích tác động -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="2dp"
            android:text="Người dùng không thể đăng nhập cho đến khi được mở khóa. Dữ liệu vẫn được lưu giữ an toàn."
            android:textColor="#70757A"
            android:textSize="12sp" />

        <!-- Hai nút bấm ngang tỉ lệ 50-50 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#EBF4EC"
                android:text="Hủy"
                android:textColor="#2D6A4F"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLock"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FFEBEE"
                android:text="Khóa"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>