<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F1">

    <!-- Phần nội dung cuộn được -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/adminBottomNav"
        android:fillViewport="true"
        android:paddingTop="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:text="←"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1E392A"
                    android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"/>

                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:text="Quản lý người dùng" android:textSize="24sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Thanh tìm kiếm -->
            <TextView android:text="Tìm tài khoản" android:textStyle="bold" android:textColor="#1E392A" android:textSize="12sp" android:layout_marginBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <EditText
                        android:id="@+id/etSearchUser"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@null"
                        android:hint="Tên hoặc email..."
                        android:textColorHint="#757575"
                        android:textSize="14sp"
                        android:inputType="text"/>
                    <TextView android:text="🔍" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tabs lọc người dùng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="#EFEBE9"
                android:padding="3dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                android:weightSum="3">

                <TextView android:id="@+id/tabAll" android:text="Tất cả (128)" android:background="@android:color/white" android:textStyle="bold" android:textColor="#1E392A" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                <TextView android:id="@+id/tabActive" android:text="Hoạt động" android:textColor="#424242" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                <TextView android:id="@+id/tabLocked" android:text="Đã khóa" android:textColor="#424242" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
            </LinearLayout>

            <!-- Danh sách người dùng -->

            <!-- User 1: Nguyên -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#E8F5E9">
                            <TextView android:text="N" android:textSize="16sp" android:textStyle="bold" android:textColor="#2E7D32" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
                            <TextView android:text="Nguyên" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="nguyen@gmail.com" android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:text="›" android:textSize="20sp" android:textColor="#757575" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Người dùng" android:textSize="10sp" android:textStyle="bold" android:textColor="#424242" android:background="#EFEBE9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Hoạt động" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:background="#E8F5E9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Khóa" android:textSize="10sp" android:textStyle="bold" android:textColor="#D32F2F" android:background="#FFEBEE" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- User 2: Minh Anh -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#E8F5E9">
                            <TextView android:text="M" android:textSize="16sp" android:textStyle="bold" android:textColor="#2E7D32" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
                            <TextView android:text="Minh Anh" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="minhanh@gmail.com" android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:text="›" android:textSize="20sp" android:textColor="#757575" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Người dùng" android:textSize="10sp" android:textStyle="bold" android:textColor="#424242" android:background="#EFEBE9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Hoạt động" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:background="#E8F5E9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Khóa" android:textSize="10sp" android:textStyle="bold" android:textColor="#D32F2F" android:background="#FFEBEE" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- User 3: Hoàng Nam -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#E8F5E9">
                            <TextView android:text="H" android:textSize="16sp" android:textStyle="bold" android:textColor="#2E7D32" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
                            <TextView android:text="Hoàng Nam" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="hoangnam@gmail.com" android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:text="›" android:textSize="20sp" android:textColor="#757575" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Người dùng" android:textSize="10sp" android:textStyle="bold" android:textColor="#424242" android:background="#EFEBE9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Đã khóa" android:textSize="10sp" android:textStyle="bold" android:textColor="#D32F2F" android:background="#FFEBEE" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Mở khóa" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:background="#E8F5E9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- User 4: Thu Hà -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#E8F5E9">
                            <TextView android:text="T" android:textSize="16sp" android:textStyle="bold" android:textColor="#2E7D32" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
                            <TextView android:text="Thu Hà" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="thuha@plantcare.vn" android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:text="›" android:textSize="20sp" android:textColor="#757575" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="Quản trị viên" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:background="#E8F5E9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Hoạt động" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:background="#E8F5E9" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginEnd="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Khóa" android:textSize="10sp" android:textStyle="bold" android:textColor="#D32F2F" android:background="#FFEBEE" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Phân trang & Footer -->
            <TextView android:text="Hiển thị 1–4 / 128 tài khoản ›" android:textSize="12sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#E8F5E9">
                <TextView android:text="Chỉ quản lý tài khoản, vai trò và trạng thái. Không truy cập nhật ký cá nhân." android:textColor="#2E7D32" android:textSize="12sp" android:padding="12dp" android:lineSpacingExtra="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Thanh điều hướng dưới cùng -->
    <LinearLayout
        android:id="@+id/adminBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:weightSum="3"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/navOverview"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:text="🛡️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Tổng quan" android:textSize="10sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAdminUsers"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:text="👥" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Người dùng" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAdminLogout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:text="🚪" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Tài khoản / Thoát" android:textSize="10sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>