<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Tiêu đề và nút đóng (X) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã gửi liên kết"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E392A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="✕"
                android:textSize="18sp"
                android:textColor="#757575"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Icon Thư tín -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="✉️"
            android:textSize="32sp" />

        <!-- Nội dung thông báo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Liên kết đặt lại mật khẩu đã được gửi tới nguyen@gmail.com."
            android:textColor="#1E392A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Kiểm tra hộp thư và làm theo hướng dẫn. Liên kết có hiệu lực trong 15 phút."
            android:textColor="#757575"
            android:textSize="12sp" />

        <!-- Nút Quay lại Đăng nhập -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#2E7D32"
            android:text="Quay lại Đăng nhập"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Đếm ngược gửi lại -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Gửi lại sau 60 giây"
            android:textColor="#757575"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>