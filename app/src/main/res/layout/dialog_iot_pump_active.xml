<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:text="Bơm đang hoạt động" android:textSize="18sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="✕" android:textSize="18sp" android:textColor="#757575" android:textStyle="bold" android:layout_alignParentEnd="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RelativeLayout>

        <!-- Badge -->
        <TextView android:text="Thủ công · Tính năng mở rộng" android:textSize="10sp" android:textStyle="bold" android:textColor="#2E7D32" android:background="#E8F5E9" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- Trạng thái -->
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="💧" android:textSize="20sp" android:layout_marginEnd="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Monstera · Đang tưới" android:textStyle="bold" android:textSize="14sp" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Mô tả -->
        <TextView android:text="Trạng thái sau khi chọn Bật bơm. Bơm tự dừng tối đa sau 20 giây." android:textColor="#757575" android:textSize="13sp" android:lineSpacingExtra="2dp" android:layout_marginBottom="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- Nút Tắt bơm -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#2E7D32"
            android:text="⏻ Tắt bơm"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Ghi chú footer -->
        <TextView android:text="Dừng ngay nếu phát hiện rò rỉ hoặc bình hết nước." android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>