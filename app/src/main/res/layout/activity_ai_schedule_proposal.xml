<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F1">

    <!-- Phần nội dung cuộn được -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomAction"
        android:fillViewport="true"
        android:paddingTop="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <TextView android:id="@+id/btnBack" android:text="←" android:textSize="24sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:text="Lịch AI đề xuất" android:textSize="24sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Card Chọn cây -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/img_monstera"/>
                    </androidx.cardview.widget.CardView>
                    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp">
                        <TextView android:text="Monstera" android:textStyle="bold" android:textSize="14sp" android:textColor="#1E392A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Trồng ngày 01/09/2026" android:textSize="11sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="▾" android:textSize="16sp" android:textColor="#757575" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Trạng thái -->
            <TextView android:text="Chưa thêm vào lịch chăm sóc" android:textSize="12sp" android:textStyle="bold" android:textColor="#F57F17" android:layout_marginBottom="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <!-- Danh sách công việc đề xuất -->

            <!-- Việc 1: Tưới nước -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="💧" android:textSize="16sp" android:layout_marginEnd="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Tưới nước" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="Mỗi 3-4 ngày" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Kiểm tra đất từ 10/10/2026 - 07:30. Chỉ tưới khi lớp đất mặt đã khô." android:textSize="13sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Việc 2: Bón phân -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="🌱" android:textSize="16sp" android:layout_marginEnd="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Bón phân" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="Mỗi 14 ngày" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Lần tiếp theo: 16/10/2026 - 08:00. Phân hữu cơ pha loãng theo hướng dẫn." android:textSize="13sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Việc 3: Công việc khác -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:text="☀️" android:textSize="16sp" android:layout_marginEnd="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Công việc khác" android:textStyle="bold" android:textColor="#1E392A" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="Lau lá, xoay chậu mỗi 7 ngày." android:textSize="16sp" android:textStyle="bold" android:textColor="#1E392A" android:layout_marginBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Bắt đầu: 12/10/2026 - 09:00" android:textSize="13sp" android:textColor="#424242" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Cụm thao tác ghim dưới cùng -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#F6F7F1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận để thêm 3 công việc vào Lịch chăm sóc hiện có. Không tạo lịch riêng; lịch trùng sẽ được bỏ qua."
            android:textSize="11sp"
            android:textColor="#757575"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#2E7D32"
            android:text="📅 Xác nhận lịch"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:color/transparent"
            android:text="Chỉnh sửa"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            app:elevation="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</RelativeLayout>